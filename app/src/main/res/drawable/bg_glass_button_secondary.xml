<?xml version="1.0" encoding="utf-8"?>
<ripple
    android:color="?colorControlHighlight"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape
                    android:shape="rectangle"
                    android:dither="true">
                    <gradient
                        android:startColor="?colorSurfaceContainerHighest"
                        android:endColor="?colorSurfaceContainerLowest"
                        android:angle="135.0" />
                    <corners
                        android:radius="28.0dip" />
                    <stroke
                        android:width="1.0dip"
                        android:color="?colorOutline" />
                </shape>
            </item>

            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="?colorSurfaceContainerLowest"
                        android:endColor="#00000000"
                        android:angle="270.0" />
                    <corners
                        android:topLeftRadius="27.0dip"
                        android:topRightRadius="27.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
