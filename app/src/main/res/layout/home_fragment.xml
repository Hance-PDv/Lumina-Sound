<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<ScrollView
		android:id="@+id/scrollViewPage"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="152dp"
			android:orientation="vertical"
			android:paddingHorizontal="12dp"
			android:clipToPadding="false">
			<RelativeLayout
				android:id="@+id/relativelayout12"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:paddingHorizontal="4dp">
				<LinearLayout
					android:id="@+id/linear24"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_alignParentStart="true">
					<TextView
						android:id="@+id/tvFlowHeaderTag"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="LUMINA PULSE"
						android:textSize="11sp"
						android:textStyle="bold"
						android:letterSpacing="0.15" />
					<TextView
						android:id="@+id/tvFlowHeaderTitle"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Audio Space"
						android:textSize="24sp"
						android:textStyle="bold" />
				</LinearLayout>
				<FrameLayout
					android:id="@+id/badgeStats"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:background="@drawable/bg_glass_card"
					android:layout_alignParentEnd="true"
					android:layout_centerVertical="true">
					<LinearLayout
						android:id="@+id/linear25"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_vertical"
						android:paddingHorizontal="12dp">
						<ImageView
							android:id="@+id/imageview10"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/default_music_image"
							android:scaleType="centerCrop"
							app:tint="?attr/colorPrimary" />
						<TextView
							android:id="@+id/tvTrackCount"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Local Flow"
							android:textSize="12sp"
							android:textStyle="bold"
							android:layout_marginStart="6dp" />
					</LinearLayout>
				</FrameLayout>
			</RelativeLayout>
			<LinearLayout
				android:id="@+id/linear26"
				android:layout_width="match_parent"
				android:layout_height="220dp"
				android:layout_marginBottom="16dp"
				android:orientation="horizontal">
				<androidx.cardview.widget.CardView
					android:id="@+id/cardBentoHero"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1.2"
					android:layout_marginEnd="8dp"
					app:cardCornerRadius="28dp"
					app:cardElevation="0dp"
					app:cardUseCompatPadding="false">
					<RelativeLayout
						android:id="@+id/relativelayout13"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:background="@drawable/bg_glass_card"
						android:clipChildren="true"
						android:clipToPadding="true">
						<ImageView
							android:id="@+id/imgBentoCover"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/default_music_image"
							android:scaleType="centerCrop"
							android:alpha="0.75" />
						<LinearLayout
							android:id="@+id/linear27"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_margin="16dp"
							android:orientation="vertical"
							android:layout_alignParentTop="true"
							android:layout_alignParentStart="true">
							<TextView
								android:id="@+id/textview10"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="SMART SHUFFLE"
								android:textSize="10sp"
								android:textStyle="bold"
								android:letterSpacing="0.1" />
							<TextView
								android:id="@+id/tvBentoTitle"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:text="Infinite\nFlow"
								android:textSize="20sp"
								android:textStyle="bold"
								android:lineSpacingExtra="2dp" />
						</LinearLayout>
						<FrameLayout
							android:id="@+id/btnBentoPlay"
							android:layout_width="52dp"
							android:layout_height="52dp"
							android:layout_margin="16dp"
							android:background="@drawable/bg_glass_button_primary"
							android:focusable="true"
							android:layout_alignParentBottom="true"
							android:layout_alignParentStart="true">
							<ImageView
								android:id="@+id/imageview22"
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:src="@drawable/icon_shuffle"
								android:scaleType="fitCenter"
								android:layout_gravity="center_horizontal|center_vertical"
								app:tint="?attr/colorOnSurface" />
						</FrameLayout>
					</RelativeLayout>
				</androidx.cardview.widget.CardView>
				<LinearLayout
					android:id="@+id/linear28"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:layout_weight="1">
					<FrameLayout
						android:id="@+id/cardBentoFavs"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:layout_marginBottom="8dp"
						android:background="@drawable/bg_glass_card_vibrant"
						android:layout_weight="1"
						android:focusable="true">
						<RelativeLayout
							android:id="@+id/relativelayout14"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:padding="14dp">
							<FrameLayout
								android:id="@+id/frame_layout36"
								android:layout_width="36dp"
								android:layout_height="36dp"
								android:background="@drawable/bg_glass_card_vibrant"
								android:layout_alignParentTop="true"
								android:layout_alignParentStart="true">
								<ImageView
									android:id="@+id/imageview11"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:padding="6dp"
									android:src="@drawable/icon_fav1"
									android:scaleType="fitCenter"
									app:tint="?attr/colorPrimary" />
							</FrameLayout>
							<LinearLayout
								android:id="@+id/linear29"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_alignParentBottom="true">
								<TextView
									android:id="@+id/textview11"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Loved"
									android:textSize="14sp"
									android:textStyle="bold" />
								<TextView
									android:id="@+id/tvFavsSubtitle"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Quick access"
									android:textSize="11sp" />
							</LinearLayout>
						</RelativeLayout>
					</FrameLayout>
					<FrameLayout
						android:id="@+id/cardBentoArtists"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:background="@drawable/bg_glass_button_primary"
						android:layout_weight="1"
						android:focusable="true">
						<RelativeLayout
							android:id="@+id/relativelayout15"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:padding="14dp">
							<FrameLayout
								android:id="@+id/frame_layout37"
								android:layout_width="36dp"
								android:layout_height="36dp"
								android:background="@drawable/bg_glass_button_primary"
								android:layout_alignParentTop="true"
								android:layout_alignParentStart="true">
								<ImageView
									android:id="@+id/imageview12"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:padding="6dp"
									android:src="@drawable/icon_art"
									android:scaleType="fitCenter"
									app:tint="?attr/colorOnSurfaceVariant" />
							</FrameLayout>
							<LinearLayout
								android:id="@+id/linear30"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_alignParentBottom="true">
								<TextView
									android:id="@+id/textview12"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Artists"
									android:textSize="14sp"
									android:textStyle="bold" />
								<TextView
									android:id="@+id/tvArtistsSubtitle"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Library index"
									android:textSize="11sp" />
							</LinearLayout>
						</RelativeLayout>
					</FrameLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linearFilterOptions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="20dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/btnFilterA"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:background="@drawable/bg_glass_button_primary"
					android:layout_marginEnd="10dp"
					android:focusable="true">
					<TextView
						android:id="@+id/textview28"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:text="A"
						android:textSize="16sp"
						android:textStyle="bold" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/btnFilterB"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:background="@drawable/bg_glass_card"
					android:layout_marginEnd="10dp"
					android:focusable="true">
					<TextView
						android:id="@+id/textview29"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:text="B"
						android:textSize="16sp"
						android:textStyle="bold" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/btnFilterC"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:background="@drawable/bg_glass_card"
					android:focusable="true">
					<TextView
						android:id="@+id/textview30"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:text="C"
						android:textSize="16sp"
						android:textStyle="bold" />
				</FrameLayout>
			</LinearLayout>
			<RelativeLayout
				android:id="@+id/relativelayout16"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/rvMainFlow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:nestedScrollingEnabled="false"
					app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
					tools:listitem="@layout/music" />
			</RelativeLayout>
		</LinearLayout>
	</ScrollView>
</RelativeLayout>
