<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/rootLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/layoutHeader"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp"
		android:paddingVertical="12dp">
		<FrameLayout
			android:id="@+id/cardview18"
			android:layout_width="46dp"
			android:layout_height="46dp"
			android:background="@drawable/bg_glass_button_secondary"
			android:focusable="true">
			<ImageView
				android:id="@+id/btnBack"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="10dp"
				android:src="@drawable/icon_arrow"
				android:scaleType="fitCenter"
				app:tint="?attr/colorOnSurface" />
		</FrameLayout>
		<TextView
			android:id="@+id/txtTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Settings"
			android:textSize="22sp"
			android:textStyle="bold"
			android:layout_marginStart="12dp" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/scrollSettings"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear13"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="24dp"
			android:orientation="vertical"
			android:paddingHorizontal="10dp">
			<TextView
				android:id="@+id/txtAudioOptHeader"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				android:text="AUDIO OPTIMIZATION"
				android:textSize="10sp"
				android:textStyle="bold"
				android:layout_marginStart="12dp"
				android:letterSpacing="0.08" />
			<FrameLayout
				android:id="@+id/cardAudioOptimization"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="28dp"
				android:background="@drawable/bg_glass_card">
				<LinearLayout
					android:id="@+id/linearAudioOpt"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/btnSlowedSong"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="12dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<ImageView
							android:id="@+id/imgSlowedIcon"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/icon_slow_motion"
							android:scaleType="fitCenter"
							android:layout_marginEnd="16dp"
							app:tint="?attr/colorOnSurface" />
						<TextView
							android:id="@+id/txtSlowedSong"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Slowed Song"
							android:textSize="15sp"
							android:textStyle="bold"
							android:layout_weight="1" />
						<com.google.android.material.materialswitch.MaterialSwitch
							android:id="@+id/switchSlowedSong"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textSize="12sp" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<TextView
				android:id="@+id/textview16"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				android:text="ABOUT &amp; SUPPORT"
				android:textSize="10sp"
				android:textStyle="bold"
				android:layout_marginStart="12dp"
				android:letterSpacing="0.08" />
			<FrameLayout
				android:id="@+id/cardAbout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="28dp"
				android:background="@drawable/bg_glass_card">
				<LinearLayout
					android:id="@+id/linear17"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/btnPrivacyPolicy"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="12dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<ImageView
							android:id="@+id/imageview17"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/icon_private"
							android:scaleType="fitCenter"
							android:layout_marginEnd="16dp"
							app:tint="?attr/colorOnSurface" />
						<TextView
							android:id="@+id/textview17"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Privacy Policy"
							android:textSize="15sp"
							android:textStyle="bold"
							android:layout_weight="1" />
						<ImageView
							android:id="@+id/imageview18"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/icon_arrow2"
							android:scaleType="fitCenter"
							app:tint="?attr/colorOnSurfaceVariant" />
					</LinearLayout>
					<View
						android:id="@+id/view18"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="?attr/colorOutline"
						android:layout_marginHorizontal="12dp" />
					<LinearLayout
						android:id="@+id/btnContact"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="12dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<ImageView
							android:id="@+id/imageview19"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/icon_email"
							android:scaleType="fitCenter"
							android:layout_marginEnd="16dp"
							app:tint="?attr/colorOnSurface" />
						<TextView
							android:id="@+id/textview18"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Contact"
							android:textSize="15sp"
							android:textStyle="bold"
							android:layout_weight="1" />
						<ImageView
							android:id="@+id/imageview20"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/icon_arrow2"
							android:scaleType="fitCenter"
							app:tint="?attr/colorOnSurfaceVariant" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<FrameLayout
				android:id="@+id/btnCheckUpdates"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_glass_button_primary"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/txtCheckUpdates"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="Check for Updates"
						android:textSize="15sp"
						android:textStyle="bold" />
				</LinearLayout>
			</FrameLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
