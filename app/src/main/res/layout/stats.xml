<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/headerContainer"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp">
		<FrameLayout
			android:id="@+id/cardBtnBack"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="@drawable/bg_glass_button_secondary"
			android:focusable="true">
			<ImageView
				android:id="@+id/btnBack"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="10dp"
				android:src="@drawable/icon_arrow"
				android:scaleType="fitCenter"
				app:tint="?attr/colorOnSurface" />
		</FrameLayout>
		<TextView
			android:id="@+id/txtHeaderTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Listening stats"
			android:textSize="22sp"
			android:textStyle="bold"
			android:layout_marginStart="12dp" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:scrollbars="none"
		android:overScrollMode="never">
		<LinearLayout
			android:id="@+id/containerMainStats"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="16dp"
			android:orientation="vertical"
			android:paddingHorizontal="16dp">
			<FrameLayout
				android:id="@+id/cardTotalTime"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:background="@drawable/bg_glass_card_accent">
				<LinearLayout
					android:id="@+id/linear15"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/lblTotalTime"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="TOTAL LISTEN TIME"
						android:textSize="11sp"
						android:textStyle="bold"
						android:letterSpacing="0.08" />
					<TextView
						android:id="@+id/txtTotalTime"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="0m"
						android:textSize="38sp"
						android:textStyle="bold" />
				</LinearLayout>
			</FrameLayout>
			<FrameLayout
				android:id="@+id/cardTopTrackOverview"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:background="@drawable/bg_glass_button_primary">
				<LinearLayout
					android:id="@+id/linear16"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview8"
						android:layout_width="56dp"
						android:layout_height="56dp"
						app:cardCornerRadius="16dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp">
						<ImageView
							android:id="@+id/imgTopTrackArt"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/icon_fav1"
							android:scaleType="centerCrop"
							app:tint="?attr/colorOnSurface" />
					</com.google.android.material.card.MaterialCardView>
					<LinearLayout
						android:id="@+id/linear17"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="14dp">
						<TextView
							android:id="@+id/lblMostPlayed"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="MOST PLAYED TRACK"
							android:textSize="10sp"
							android:textStyle="bold"
							android:letterSpacing="0.08" />
						<TextView
							android:id="@+id/txtTopTrackDetail"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="None"
							android:textSize="16sp"
							android:textStyle="bold"
							android:ellipsize="end"
							android:maxLines="1" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<LinearLayout
				android:id="@+id/linear18"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/cardTotalPlays"
					android:layout_width="0dp"
					android:layout_height="110dp"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginEnd="6dp">
					<LinearLayout
						android:id="@+id/linear19"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="16dp"
						android:gravity="bottom"
						android:orientation="vertical">
						<TextView
							android:id="@+id/txtTotalPlaysDetail"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0"
							android:textSize="26sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/lblTotalPlays"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="TOTAL PLAYS"
							android:textSize="10sp"
							android:textStyle="bold"
							android:letterSpacing="0.05" />
					</LinearLayout>
				</FrameLayout>
				<FrameLayout
					android:id="@+id/cardUniqueTracks"
					android:layout_width="0dp"
					android:layout_height="110dp"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginStart="6dp">
					<LinearLayout
						android:id="@+id/linear20"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="16dp"
						android:gravity="bottom"
						android:orientation="vertical">
						<TextView
							android:id="@+id/txtExploredDetail"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0"
							android:textSize="26sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/lblUniqueTracks"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="UNIQUE TRACKS"
							android:textSize="10sp"
							android:textStyle="bold"
							android:letterSpacing="0.05" />
					</LinearLayout>
				</FrameLayout>
			</LinearLayout>
			<FrameLayout
				android:id="@+id/cardAverages"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:background="@drawable/bg_glass_card">
				<LinearLayout
					android:id="@+id/linear21"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear22"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/lblDailyAvg"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="DAILY AVG"
							android:textSize="10sp"
							android:textStyle="bold"
							android:letterSpacing="0.05" />
						<TextView
							android:id="@+id/txtDailyAvg"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="0m / day"
							android:textSize="16sp"
							android:textStyle="bold" />
					</LinearLayout>
					<View
						android:id="@+id/view23"
						android:layout_width="1dp"
						android:layout_height="match_parent"
						android:background="?attr/colorOutline"
						android:layout_marginStart="12dp"
						android:layout_marginEnd="12dp" />
					<LinearLayout
						android:id="@+id/linear24"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/lblWeeklyAvg"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="WEEKLY AVG"
							android:textSize="10sp"
							android:textStyle="bold"
							android:letterSpacing="0.05" />
						<TextView
							android:id="@+id/txtWeeklyAvg"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="0h / week"
							android:textSize="16sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<FrameLayout
				android:id="@+id/cardTopTracksGroup"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:background="@drawable/bg_glass_card">
				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/lblTop3Tracks"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:text="TOP 3 TRACKS"
						android:textSize="10sp"
						android:textStyle="bold"
						android:letterSpacing="0.08" />
					<LinearLayout
						android:id="@+id/cardTopTrack1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:visibility="gone">
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview9"
							android:layout_width="42dp"
							android:layout_height="42dp"
							app:cardCornerRadius="12dp"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<ImageView
								android:id="@+id/imgTopTrackArt1"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:src="@drawable/icon_fav1"
								android:scaleType="centerCrop" />
						</com.google.android.material.card.MaterialCardView>
						<LinearLayout
							android:id="@+id/linear26"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="12dp">
							<TextView
								android:id="@+id/txtTopTrackTitle1"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Track Title 1"
								android:textSize="14sp"
								android:textStyle="bold"
								android:ellipsize="end"
								android:maxLines="1" />
							<TextView
								android:id="@+id/txtTopTrackArtist1"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Artist 1"
								android:textSize="12sp"
								android:ellipsize="end"
								android:maxLines="1" />
						</LinearLayout>
						<FrameLayout
							android:id="@+id/cardview10"
							android:layout_width="32dp"
							android:layout_height="32dp"
							android:background="@drawable/bg_glass_button_secondary">
							<TextView
								android:id="@+id/txtTopTrackPlays1"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:gravity="center_horizontal|center_vertical"
								android:text="0"
								android:textSize="11sp"
								android:textStyle="bold" />
						</FrameLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/cardTopTrack2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:visibility="gone">
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview11"
							android:layout_width="42dp"
							android:layout_height="42dp"
							app:cardCornerRadius="12dp"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<ImageView
								android:id="@+id/imgTopTrackArt2"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:src="@drawable/icon_fav1"
								android:scaleType="centerCrop" />
						</com.google.android.material.card.MaterialCardView>
						<LinearLayout
							android:id="@+id/linear27"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="12dp">
							<TextView
								android:id="@+id/txtTopTrackTitle2"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Track Title 2"
								android:textSize="14sp"
								android:textStyle="bold"
								android:ellipsize="end"
								android:maxLines="1" />
							<TextView
								android:id="@+id/txtTopTrackArtist2"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Artist 2"
								android:textSize="12sp"
								android:ellipsize="end"
								android:maxLines="1" />
						</LinearLayout>
						<FrameLayout
							android:id="@+id/cardview12"
							android:layout_width="32dp"
							android:layout_height="32dp"
							android:background="@drawable/bg_glass_button_secondary">
							<TextView
								android:id="@+id/txtTopTrackPlays2"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:gravity="center_horizontal|center_vertical"
								android:text="0"
								android:textSize="11sp"
								android:textStyle="bold" />
						</FrameLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/cardTopTrack3"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:visibility="gone">
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview13"
							android:layout_width="42dp"
							android:layout_height="42dp"
							app:cardCornerRadius="12dp"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<ImageView
								android:id="@+id/imgTopTrackArt3"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:src="@drawable/icon_fav1"
								android:scaleType="centerCrop" />
						</com.google.android.material.card.MaterialCardView>
						<LinearLayout
							android:id="@+id/linear28"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="12dp">
							<TextView
								android:id="@+id/txtTopTrackTitle3"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Track Title 3"
								android:textSize="14sp"
								android:textStyle="bold"
								android:ellipsize="end"
								android:maxLines="1" />
							<TextView
								android:id="@+id/txtTopTrackArtist3"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Artist 3"
								android:textSize="12sp"
								android:ellipsize="end"
								android:maxLines="1" />
						</LinearLayout>
						<FrameLayout
							android:id="@+id/cardview14"
							android:layout_width="32dp"
							android:layout_height="32dp"
							android:background="@drawable/bg_glass_button_secondary">
							<TextView
								android:id="@+id/txtTopTrackPlays3"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:gravity="center_horizontal|center_vertical"
								android:text="0"
								android:textSize="11sp"
								android:textStyle="bold" />
						</FrameLayout>
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<FrameLayout
				android:id="@+id/cardResetStats"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="16dp"
				android:background="@drawable/bg_glass_button_error"
				android:focusable="true">
				<TextView
					android:id="@+id/txtResetStats"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="14dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="Reset Listening Stats"
					android:textSize="13sp"
					android:textStyle="bold" />
			</FrameLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
