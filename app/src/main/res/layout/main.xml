<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/splash_content_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:visibility="visible">
		<LinearLayout
			android:id="@+id/linear34"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:layout_weight="1"
			android:paddingHorizontal="24dp">
			<RelativeLayout
				android:id="@+id/frame_layout35"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical">
				<ImageView
					android:id="@+id/txt_m"
					android:layout_width="120dp"
					android:layout_height="120dp"
					android:src="@drawable/default_music_image"
					android:scaleType="fitCenter"
					app:tint="?attr/colorPrimary"
					android:layout_centerInParent="true" />
				<LinearLayout
					android:id="@+id/full_name_container"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:alpha="0"
					android:layout_centerInParent="true">
					<TextView
						android:id="@+id/textview8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="L"
						android:textSize="58sp"
						android:textStyle="bold"
						android:includeFontPadding="false"
						android:letterSpacing="0.05" />
					<TextView
						android:id="@+id/txt_flow"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="umina"
						android:textSize="58sp"
						android:textStyle="bold"
						android:includeFontPadding="false"
						android:letterSpacing="0.05" />
				</LinearLayout>
			</RelativeLayout>
			<TextView
				android:id="@+id/txt_subtitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="P L A Y   Y O U R   W A Y"
				android:textSize="11sp"
				android:letterSpacing="0.25" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/bottom_container"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="40dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical">
			<ProgressBar
				android:id="@+id/lottie_loading"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:indeterminate="true"
				style="?android:progressBarStyle"
				android:indeterminateTint="?attr/colorPrimary" />
			<LinearLayout
				android:id="@+id/linear36"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/txt_version"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="v1.0"
					android:textSize="11sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/textview9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="  •  "
					android:textSize="10sp" />
				<TextView
					android:id="@+id/textview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="by\\\\\@x_hance"
					android:textSize="11sp" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/maintenance_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:paddingHorizontal="32dp"
		android:visibility="gone"
		tools:visibility="visible">
		<LinearLayout
			android:id="@+id/linear6"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:layout_weight="1">
			<FrameLayout
				android:id="@+id/maint_icon_wrapper"
				android:layout_width="104dp"
				android:layout_height="104dp"
				android:layout_marginBottom="28dp"
				android:padding="14dp"
				android:background="@drawable/bg_glass_card">
				<ImageView
					android:id="@+id/img_maintenance"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/default_music_image"
					android:scaleType="fitCenter"
					app:tint="?attr/colorPrimary" />
			</FrameLayout>
			<TextView
				android:id="@+id/txt_maint_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:text="New Update Available"
				android:textSize="25sp"
				android:textStyle="bold"
				android:letterSpacing="0.02" />
			<TextView
				android:id="@+id/txt_maint_message"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="A new version of MFlow is available with improvements and fixes. Update now to get the best experience."
				android:textSize="14sp"
				android:lineSpacingExtra="4dp" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/maint_bottom_container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="36dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical">
			<FrameLayout
				android:id="@+id/btn_maint_update"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:background="@drawable/bg_glass_button_primary"
				android:focusable="true">
				<TextView
					android:id="@+id/txt_btn_update"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="UPDATE MFLOW NOW"
					android:textSize="14sp"
					android:textStyle="bold"
					android:layout_gravity="center_horizontal|center_vertical"
					android:letterSpacing="0.05" />
			</FrameLayout>
			<LinearLayout
				android:id="@+id/layout_skip_options"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/container_dont_remind"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:focusable="true"
					android:visibility="gone"
					tools:visibility="visible">
					<com.google.android.material.checkbox.MaterialCheckBox
						android:id="@+id/chk_dont_remind"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minWidth="0dp"
						android:minHeight="0dp"
						app:buttonTint="?attr/colorPrimary" />
					<TextView
						android:id="@+id/txt_dont_remind"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Don't remind me"
						android:textSize="12sp"
						android:layout_marginStart="2dp" />
				</LinearLayout>
				<TextView
					android:id="@+id/btn_maint_skip"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Skip for now"
					android:textSize="13sp"
					android:textStyle="bold"
					android:layout_marginStart="14dp"
					android:focusable="true"
					android:visibility="gone"
					tools:visibility="visible" />
			</LinearLayout>
			<TextView
				android:id="@+id/txt_maint_footer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:text="Hance-PDv"
				android:textSize="11sp"
				android:alpha="0.6" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
