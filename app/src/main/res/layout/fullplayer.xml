<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<ImageView
		android:id="@+id/img_blur_bg"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:src="@drawable/default_music_image"
		android:scaleType="centerCrop" />
	<LinearLayout
		android:id="@+id/linear2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingTop="36dp"
		android:paddingBottom="16dp"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/mTopLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingHorizontal="16dp"
			android:paddingVertical="4dp">
			<FrameLayout
				android:id="@+id/cardview16"
				android:layout_width="46dp"
				android:layout_height="46dp"
				android:background="@drawable/bg_glass_button_secondary"
				android:focusable="true">
				<ImageView
					android:id="@+id/img_back"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="11dp"
					android:src="@drawable/icon_arrow"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnSurface" />
			</FrameLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/PlayerLayout"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:layout_weight="1"
			android:paddingHorizontal="20dp">
			<androidx.constraintlayout.widget.ConstraintLayout
				android:id="@+id/constraint_layout17"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:paddingVertical="4dp">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/mAlbumCardView"
					android:layout_width="0dp"
					android:layout_height="0dp"
					app:cardCornerRadius="10dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp"
					app:cardPreventCornerOverlap="false"
					app:layout_constraintDimensionRatio="1:1"
					app:layout_constraintWidth_max="300dp"
					app:layout_constraintTop_toTopOf="parent"
					app:layout_constraintBottom_toTopOf="@id/layoutSongMetaInfo"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintEnd_toEndOf="parent">
					<ImageView
						android:id="@+id/mAlbumImageView"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:src="@drawable/default_music_image"
						android:scaleType="centerCrop" />
				</com.google.android.material.card.MaterialCardView>
				<LinearLayout
					android:id="@+id/layoutSongMetaInfo"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingVertical="2dp"
					app:layout_constraintTop_toBottomOf="@id/mAlbumCardView"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintEnd_toEndOf="parent">
					<LinearLayout
						android:id="@+id/linear119"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/titlef"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Music title"
							android:textSize="18sp"
							android:textStyle="bold"
							android:singleLine="true"
							android:ellipsize="marquee"
							android:marqueeRepeatLimit="marquee_forever"
							android:focusable="true"
							android:focusableInTouchMode="true" />
						<TextView
							android:id="@+id/artf"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="Artist name"
							android:textSize="13sp"
							android:singleLine="true"
							android:ellipsize="end" />
					</LinearLayout>
					<FrameLayout
						android:id="@+id/cardview94_fav"
						android:layout_width="45dp"
						android:layout_height="42dp"
						android:background="@drawable/bg_glass_button_secondary"
						android:layout_marginStart="8dp"
						android:focusable="true">
						<ImageView
							android:id="@+id/fave"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:padding="9dp"
							android:src="@drawable/icon_fav"
							android:scaleType="fitCenter"
							app:tint="?attr/colorOnSurface" />
					</FrameLayout>
					<FrameLayout
						android:id="@+id/cardview94"
						android:layout_width="45dp"
						android:layout_height="42dp"
						android:background="@drawable/bg_glass_button_secondary"
						android:layout_marginStart="8dp"
						android:focusable="true">
						<ImageView
							android:id="@+id/repeat"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:padding="9dp"
							android:src="@drawable/icon_repeat"
							android:scaleType="fitCenter"
							app:tint="?attr/colorOnSurface" />
					</FrameLayout>
				</LinearLayout>
				<FrameLayout
					android:id="@+id/mLyricsCardView"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:background="@android:color/transparent"
					android:visibility="gone"
					app:layout_constraintTop_toBottomOf="@id/layoutSongMetaInfo"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintEnd_toEndOf="parent">
					<com.lumina.music.AppleLyricsView
						android:id="@+id/appleLyricsView"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:paddingHorizontal="24dp" />
				</FrameLayout>
			</androidx.constraintlayout.widget.ConstraintLayout>
			<Space
				android:id="@+id/space120"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="0.12" />
			<LinearLayout
				android:id="@+id/mMusicProgressLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<SeekBar
					android:id="@+id/SeekBar1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="@null"
					android:maxHeight="16dp"
					android:minHeight="16dp"
					android:paddingStart="0dp"
					android:paddingEnd="0dp"
					android:progressDrawable="@drawable/custom_seekbar"
					android:thumb="@drawable/custom_thumb"
					android:thumbOffset="0dp"
					android:splitTrack="false" />
				<LinearLayout
					android:id="@+id/linear54"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/pros"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="0:00"
						android:textSize="11sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/linear55"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/time"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="0:00"
						android:textSize="11sp"
						android:textStyle="bold" />
				</LinearLayout>
			</LinearLayout>
			<Space
				android:id="@+id/space121"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="0.12" />
			<LinearLayout
				android:id="@+id/mMediaPlayerControlButtonsLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/cardview96"
					android:layout_width="52dp"
					android:layout_height="52dp"
					android:background="@drawable/bg_glass_card_accent"
					android:layout_marginEnd="24dp"
					android:focusable="true">
					<ImageView
						android:id="@+id/back"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="11dp"
						android:src="@drawable/icon_previous"
						android:scaleType="fitCenter"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/cardview97"
					android:layout_width="68dp"
					android:layout_height="68dp"
					android:background="@drawable/bg_glass_button_primary"
					android:focusable="true">
					<ImageView
						android:id="@+id/play"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="15dp"
						android:src="@drawable/icon_play"
						android:scaleType="fitCenter"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/cardview98"
					android:layout_width="52dp"
					android:layout_height="52dp"
					android:background="@drawable/bg_glass_card_accent"
					android:layout_marginStart="24dp"
					android:focusable="true">
					<ImageView
						android:id="@+id/next"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="11dp"
						android:src="@drawable/icon_next"
						android:scaleType="fitCenter"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
			</LinearLayout>
			<Space
				android:id="@+id/space122"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="0.12" />
			<FrameLayout
				android:id="@+id/cardview93"
				android:layout_width="wrap_content"
				android:layout_height="46dp"
				android:background="@drawable/bg_glass_card_accent">
				<LinearLayout
					android:id="@+id/linear123"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingHorizontal="8dp">
					<LinearLayout
						android:id="@+id/btn_lyrics_container"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:paddingHorizontal="16dp"
						android:focusable="true">
						<ImageView
							android:id="@+id/btn_lyrics"
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:src="@drawable/icon_lyrics1"
							android:scaleType="fitCenter"
							app:tint="?attr/colorOnSurface" />
					</LinearLayout>
					<View
						android:id="@+id/view124"
						android:layout_width="1dp"
						android:layout_height="20dp"
						android:background="#FFFFFF" />
					<LinearLayout
						android:id="@+id/cardview55"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:paddingHorizontal="16dp"
						android:focusable="true">
						<ImageView
							android:id="@+id/sleep"
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:src="@drawable/icon_night1"
							android:scaleType="fitCenter"
							app:tint="?attr/colorOnSurface" />
						<TextView
							android:id="@+id/text1"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textSize="12sp"
							android:textStyle="bold"
							android:layout_marginStart="6dp"
							android:visibility="gone" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>
			<Space
				android:id="@+id/space125"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="0.12" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
