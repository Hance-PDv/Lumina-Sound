<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscrollMain"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linear39"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="10dp"
			android:paddingRight="10dp"
			android:paddingBottom="152dp"
			android:orientation="vertical"
			android:clipToPadding="false">
			<LinearLayout
				android:id="@+id/linear40"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:orientation="horizontal"
				android:weightSum="2">
				<FrameLayout
					android:id="@+id/cardFavorites"
					android:layout_width="0dp"
					android:layout_height="110dp"
					android:background="@drawable/bg_glass_button_primary"
					android:layout_weight="1"
					android:layout_marginEnd="8dp"
					android:focusable="true">
					<RelativeLayout
						android:id="@+id/relativelayout3"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="14dp">
						<FrameLayout
							android:id="@+id/cardview14"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:background="@drawable/bg_glass_button_secondary">
							<ImageView
								android:id="@+id/imageview19"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:padding="8dp"
								android:src="@drawable/icon_fav1"
								android:scaleType="fitCenter"
								app:tint="?attr/colorOnSurface" />
						</FrameLayout>
						<TextView
							android:id="@+id/textview12"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Favorites"
							android:textSize="20sp"
							android:textStyle="bold"
							android:layout_alignParentBottom="true" />
					</RelativeLayout>
				</FrameLayout>
				<FrameLayout
					android:id="@+id/cardHistory"
					android:layout_width="0dp"
					android:layout_height="110dp"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					android:focusable="true">
					<RelativeLayout
						android:id="@+id/relativelayout4"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="14dp">
						<FrameLayout
							android:id="@+id/cardview15"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:background="@drawable/bg_glass_button_secondary">
							<ImageView
								android:id="@+id/imageview20"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:padding="8dp"
								android:src="@drawable/icon_stats"
								android:scaleType="fitCenter"
								app:tint="?attr/colorOnSurface" />
						</FrameLayout>
						<TextView
							android:id="@+id/textview13"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Listening Stats"
							android:textSize="20sp"
							android:textStyle="bold"
							android:layout_alignParentBottom="true" />
					</RelativeLayout>
				</FrameLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear57"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:padding="5dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/cardview16"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:background="@drawable/bg_glass_card">
					<LinearLayout
						android:id="@+id/linear58"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:paddingHorizontal="14dp">
						<TextView
							android:id="@+id/textview18"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Your lists"
							android:textSize="13sp"
							android:textStyle="bold" />
					</LinearLayout>
				</FrameLayout>
				<FrameLayout
					android:id="@+id/btnCreatePlaylist"
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:background="@drawable/bg_glass_button_primary"
					android:layout_marginStart="8dp"
					android:focusable="true">
					<ImageView
						android:id="@+id/imageview2"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:src="@drawable/ic_add"
						android:scaleType="fitCenter"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
			</LinearLayout>
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/rvPlaylists"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:nestedScrollingEnabled="false"
				app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
				tools:itemCount="1"
				tools:listitem="@layout/listplay" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</RelativeLayout>
