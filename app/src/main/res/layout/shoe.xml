<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear28"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="6dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp">
		<FrameLayout
			android:id="@+id/btnBack"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="@drawable/bg_glass_button_secondary"
			android:layout_marginEnd="12dp"
			android:focusable="true">
			<ImageView
				android:id="@+id/imageview12"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="10dp"
				android:src="@drawable/icon_arrow"
				android:scaleType="fitCenter"
				android:layout_gravity="center_horizontal|center_vertical"
				app:tint="?attr/colorOnSurface" />
		</FrameLayout>
		<TextView
			android:id="@+id/txtFavoritesTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Favorites"
			android:textSize="24sp"
			android:textStyle="bold" />
	</LinearLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll6"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linear18"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="8dp"
			android:orientation="vertical"
			android:paddingHorizontal="16dp">
			<LinearLayout
				android:id="@+id/linear30"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:weightSum="2">
				<FrameLayout
					android:id="@+id/cardview3"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginEnd="6dp">
					<TextView
						android:id="@+id/txtFavCount"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="3 Songs"
						android:textSize="13sp"
						android:textStyle="bold"
						android:paddingVertical="12dp" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/cardview4"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginStart="6dp">
					<TextView
						android:id="@+id/txtFavStatus"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="09:56"
						android:textSize="13sp"
						android:textStyle="bold"
						android:paddingVertical="12dp" />
				</FrameLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear20"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="20dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/btnPlayAll"
					android:layout_width="0dp"
					android:layout_height="56dp"
					android:background="@drawable/bg_glass_button_primary"
					android:layout_weight="1"
					android:layout_marginEnd="12dp"
					android:focusable="true">
					<ImageView
						android:id="@+id/imageview7"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="12dp"
						android:src="@drawable/icon_play"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal|center_vertical"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/btnShuffle"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:background="@drawable/bg_glass_button_secondary"
					android:focusable="true">
					<ImageView
						android:id="@+id/imageview8"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="12dp"
						android:src="@drawable/icon_shuffle"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal|center_vertical"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
			</LinearLayout>
			<RelativeLayout
				android:id="@+id/relativelayout1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<LinearLayout
					android:id="@+id/NoMusicFoundLayout"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="32dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:visibility="gone">
					<ImageView
						android:id="@+id/NoMusicFoundLayoutIcon"
						android:layout_width="110dp"
						android:layout_height="110dp"
						android:layout_marginBottom="12dp"
						android:src="@drawable/icon_music"
						android:scaleType="fitCenter"
						app:tint="?attr/colorOnSurfaceVariant" />
					<TextView
						android:id="@+id/NoMusicFoundLayoutTitle"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="4dp"
						android:text="No favorite music"
						android:textSize="18sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/NoMusicFoundLayoutDesc"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="You can add in using the fav button"
						android:textSize="14sp"
						android:paddingHorizontal="16dp" />
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/rvFavoritesTracks"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:nestedScrollingEnabled="false"
					app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
					tools:itemCount="3"
					tools:listitem="@layout/music" />
			</RelativeLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
