<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linearHeader"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="6dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp">
		<FrameLayout
			android:id="@+id/cardBack"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="@drawable/bg_glass_button_secondary"
			android:layout_marginEnd="12dp"
			android:focusable="true">
			<ImageView
				android:id="@+id/btnBack"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="10dp"
				android:src="@drawable/icon_arrow"
				android:scaleType="fitCenter"
				android:layout_gravity="center_horizontal|center_vertical"
				app:tint="?attr/colorOnSurface" />
		</FrameLayout>
		<TextView
			android:id="@+id/txtPlaylistTitle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="Playlist Name"
			android:textSize="22sp"
			android:textStyle="bold"
			android:singleLine="true"
			android:layout_weight="1"
			android:ellipsize="end" />
		<FrameLayout
			android:id="@+id/btnDeletePlaylist"
			android:layout_width="wrap_content"
			android:layout_height="44dp"
			android:background="@drawable/bg_glass_button_secondary"
			android:focusable="true">
			<LinearLayout
				android:id="@+id/linear6"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="4dp"
				android:paddingEnd="4dp">
				<ImageView
					android:id="@+id/btn_remove_playlist"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:padding="4dp"
					android:background="@android:color/transparent"
					android:src="@drawable/icon_remove_circle"
					android:scaleType="fitCenter"
					android:layout_marginStart="4dp"
					android:layout_marginEnd="4dp"
					app:tint="?attr/colorError"
					android:visibility="gone"
					android:focusable="false" />
				<com.google.android.material.checkbox.MaterialCheckBox
					android:id="@+id/checkboxPlaylist"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:background="@android:color/transparent"
					android:layout_marginStart="4dp"
					android:layout_marginEnd="4dp"
					android:visibility="gone"
					android:focusable="false" />
				<ImageView
					android:id="@+id/imageview_delete"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:padding="4dp"
					android:src="@drawable/icon_delete"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnSurface"
					android:layout_marginStart="4dp"
					android:layout_marginEnd="4dp"
					android:focusable="false" />
			</LinearLayout>
		</FrameLayout>
	</LinearLayout>
	<RelativeLayout
		android:id="@+id/relativelayout2"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">
		<androidx.core.widget.NestedScrollView
			android:id="@+id/vscroll4"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fillViewport="true"
			android:overScrollMode="never"
			android:scrollbars="none">
			<LinearLayout
				android:id="@+id/linear1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="8dp"
				android:paddingBottom="88dp"
				android:orientation="vertical"
				android:paddingHorizontal="16dp">
				<LinearLayout
					android:id="@+id/linear20"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="20dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<FrameLayout
						android:id="@+id/btnPlayAll"
						android:layout_width="0dp"
						android:layout_height="56dp"
						android:background="@drawable/bg_glass_button_primary"
						android:layout_weight="1"
						android:layout_marginEnd="12dp"
						android:focusable="true">
						<ImageView
							android:id="@+id/imageview7"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:padding="12dp"
							android:src="@drawable/icon_play"
							android:scaleType="fitCenter"
							android:layout_gravity="center_horizontal|center_vertical"
							app:tint="?attr/colorOnSurface" />
					</FrameLayout>
					<FrameLayout
						android:id="@+id/btnShuffle"
						android:layout_width="56dp"
						android:layout_height="56dp"
						android:background="@drawable/bg_glass_button_secondary"
						android:focusable="true">
						<ImageView
							android:id="@+id/imageview8"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:padding="12dp"
							android:src="@drawable/icon_shuffle"
							android:scaleType="fitCenter"
							android:layout_gravity="center_horizontal|center_vertical"
							app:tint="?attr/colorOnSurface" />
					</FrameLayout>
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/rvPlaylistSongs"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:nestedScrollingEnabled="false"
					app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
					tools:itemCount="5"
					tools:listitem="@layout/dome" />
			</LinearLayout>
		</androidx.core.widget.NestedScrollView>
		<FrameLayout
			android:id="@+id/btnAddSongs"
			android:layout_width="72dp"
			android:layout_height="48dp"
			android:layout_marginBottom="16dp"
			android:background="@drawable/bg_glass_button_primary"
			android:focusable="true"
			android:elevation="6dp"
			android:layout_alignParentBottom="true"
			android:layout_centerHorizontal="true">
			<ImageView
				android:id="@+id/imageview2"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="6dp"
				android:src="@drawable/ic_add"
				android:scaleType="fitCenter"
				app:tint="?attr/colorOnSurface" />
		</FrameLayout>
	</RelativeLayout>
</LinearLayout>
