<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linearHeader"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="6dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp">
		<FrameLayout
			android:id="@+id/btnBack"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="@drawable/bg_glass_button_secondary"
			android:layout_marginEnd="12dp"
			android:focusable="true">
			<ImageView
				android:id="@+id/imgBack"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="10dp"
				android:src="@drawable/icon_arrow"
				android:scaleType="fitCenter"
				android:layout_gravity="center_horizontal|center_vertical"
				app:tint="?attr/colorOnSurface" />
		</FrameLayout>
		<TextView
			android:id="@+id/txtArtistName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Artist Name"
			android:textSize="24sp"
			android:textStyle="bold"
			android:maxLines="1"
			android:ellipsize="end" />
	</LinearLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/nestedScrollView"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linearContent"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="8dp"
			android:orientation="vertical"
			android:paddingHorizontal="16dp">
			<LinearLayout
				android:id="@+id/linearStats"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:weightSum="2">
				<FrameLayout
					android:id="@+id/cardSongCount"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginEnd="6dp">
					<TextView
						android:id="@+id/txtSongCount"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="0 Tracks"
						android:textSize="13sp"
						android:textStyle="bold"
						android:paddingVertical="12dp" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/cardTotalDuration"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_glass_card"
					android:layout_weight="1"
					android:layout_marginStart="6dp">
					<TextView
						android:id="@+id/txtTotalDuration"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="00:00"
						android:textSize="13sp"
						android:textStyle="bold"
						android:paddingVertical="12dp" />
				</FrameLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linearActions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="20dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/btnPlayAll"
					android:layout_width="0dp"
					android:layout_height="56dp"
					android:background="@drawable/bg_glass_button_primary"
					android:layout_weight="1"
					android:layout_marginEnd="12dp"
					android:focusable="true">
					<ImageView
						android:id="@+id/imgPlay"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="12dp"
						android:src="@drawable/icon_play"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal|center_vertical"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/btnShuffle"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:background="@drawable/bg_glass_button_secondary"
					android:focusable="true">
					<ImageView
						android:id="@+id/imgShuffle"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="12dp"
						android:src="@drawable/icon_shuffle"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal|center_vertical"
						app:tint="?attr/colorOnSurface" />
				</FrameLayout>
			</LinearLayout>
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/rvArtistTracks"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:nestedScrollingEnabled="false"
				app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
				tools:itemCount="5"
				tools:listitem="@layout/music" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
